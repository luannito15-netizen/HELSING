*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

# Assets de texto do Unity. O Unity sempre grava LF; com core.autocrlf=true o
# git quer reescrever para CRLF e passa a reportar como modificados arquivos
# cujo conteudo nunca mudou. Declarar eol=lf elimina esses falsos positivos.
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
manifest.json text eol=lf
packages-lock.json text eol=lf
